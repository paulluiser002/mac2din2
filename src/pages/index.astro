---
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/bodoni-moda/400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Showroom from '../components/Showroom';
import { projects, imageSet } from '../data/projects';

const details = [
  { image: 'sheer-room', title: 'The quiet beauty of a pleat', type: 'Sheers & drapes', position: '68% 36%' },
  { image: 'classic-room', title: 'A more decorative expression', type: 'Swags & finishing details', position: '60% 16%' },
  { image: 'tall-room', title: 'Every window has its own scale', type: 'Double-height curtains', position: '69% 28%' },
  { image: 'blinds-room', title: 'A different way to filter light', type: 'Korean blinds', position: '23% 35%' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf7" />
    <title>Mac2Din2 House of Curtains — A different feeling. In every fold.</title>
    <meta name="description" content="Explore curtains, sheers and blinds by Mac2Din2 House of Curtains. Discover our installations and contact us about your windows." />
    <meta property="og:title" content="Mac2Din2 House of Curtains" />
    <meta property="og:description" content="A different feeling. In every fold. Explore our curtain and blind installations." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="image" href="/images/room-poster-1280.webp" />
  </head>
  <body>
    <div class="opening-curtain" id="opening-curtain">
      <div class="opening-panel opening-left" aria-hidden="true">{Array.from({ length: 18 }, () => <span class="opening-fold"></span>)}</div>
      <div class="opening-panel opening-right" aria-hidden="true">{Array.from({ length: 18 }, () => <span class="opening-fold"></span>)}</div>
      <div class="opening-signature" aria-hidden="true"><span>Mac2Din2</span><span>House of Curtains</span></div>
      <button class="opening-skip" type="button">Skip intro <Icon /></button>
    </div>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="#" aria-label="Mac2Din2 House of Curtains home"><img src="/images/logo.webp" width="130" height="100" alt="Mac2Din2 House of Curtains" fetchpriority="high" /></a>
      <nav aria-label="Main navigation">
        <a href="#works">Our work</a>
        <a href="#curtains" class="nav-secondary">Curtains & blinds</a>
        <a href="#approach" class="nav-secondary">Our approach</a>
      </nav>
      <a class="header-contact" href="#contact">Contact us <Icon /></a>
    </header>

    <main id="main">
      <section class="showroom" id="showroom" aria-labelledby="hero-heading">
        <div class="showroom-pin">
          <div class="room-frame" id="room-frame" aria-hidden="true">
            <img class="room-poster" id="room-poster" src="/images/room-poster-1280.webp" srcset="/images/room-poster-640.webp 640w, /images/room-poster-1280.webp 1280w" sizes="(max-width: 700px) 100vw, 75vw" width="1280" height="720" alt="" fetchpriority="high" />
            <div id="scene-mount"><Showroom client:idle /></div>
          </div>
          <div class="hero-wash"></div>
          <div class="hero-intro">
            <h1 id="hero-heading">A different feeling.<br />In every fold.</h1>
            <p>Curtains and blinds that bring<br class="desktop-break" /> your space together.</p>
            <div class="hero-actions">
              <a class="button button-dark" href="#contact">Let’s talk about your windows <Icon /></a>
              <a class="text-link" href="#works">Explore our work</a>
            </div>
          </div>
          <div class="hero-story" aria-hidden="true">
            <h2>Let the light<br />change everything.</h2>
            <p>A softer morning. A quieter afternoon.<br />A room that feels more like you.</p>
          </div>
          <div class="hero-bottom">
            <div class="scroll-note"><span class="scroll-line"></span><span>Scroll to let the light in</span></div>
            <p class="scene-caption" id="scene-caption">Illustrative room</p>
          </div>
          <div class="room-controls" id="room-controls" aria-label="Explore the illustrative room" hidden>
            <div class="view-controls" aria-label="Curtain view">
              <button type="button" data-view="sheer" aria-pressed="false">Sheer</button>
              <button type="button" data-view="layered" aria-pressed="false">Layered</button>
              <button type="button" data-view="closed" aria-pressed="false">Closed</button>
              <button type="button" data-view="scroll" class="reset-view" aria-pressed="true" aria-label="Reset curtain view to follow scrolling">Reset view</button>
            </div>
            <div class="fabric-controls"><span>Fabric</span>
              <button class="fabric-swatch fabric-stone" type="button" data-fabric="stone" aria-label="Stone fabric" aria-pressed="true"></button>
              <button class="fabric-swatch fabric-olive" type="button" data-fabric="olive" aria-label="Olive fabric" aria-pressed="false"></button>
              <button class="fabric-swatch fabric-ivory" type="button" data-fabric="ivory" aria-label="Ivory fabric" aria-pressed="false"></button>
              <span class="fabric-name" id="fabric-name">Stone</span>
            </div>
          </div>
        </div>
      </section>

      <section class="introduction section-pad" id="curtains" aria-labelledby="intro-heading">
        <div class="intro-heading"><span class="decorative-fold" aria-hidden="true" data-parallax="35"></span><h2 id="intro-heading">A little privacy.<br />A lot of possibility.</h2></div>
        <div class="intro-copy"><p>The way light falls. The softness of a room. The final detail that makes a space feel complete.</p><p>Explore pleated sheers, layered drapes, classic curtains and blinds, with inspiration from the homes we’ve worked on.</p><a class="text-link" href="#contact">Find the right feeling for your home <Icon /></a></div>
      </section>

      <section class="work-section" id="works" aria-labelledby="works-heading" data-carousel>
        <div class="section-heading section-pad">
          <h2 id="works-heading">Real rooms.<br />Beautifully finished.</h2>
          <div class="section-heading-side"><p>A closer look at our curtain<br />and blind installations.</p><div class="carousel-navigation"><span class="slide-count" data-count aria-live="polite">1 / {projects.length}</span><button class="circle-button previous" data-prev aria-label="Previous installation" disabled><Icon name="chevron" /></button><button class="circle-button" data-next aria-label="Next installation"><Icon name="chevron" /></button></div></div>
        </div>
        <div class="work-track" data-track aria-label="Installation photographs" role="region" tabindex="0">
          {projects.map(project => (
            <figure class="work-slide" data-slide>
              <div class="work-photo"><img src={`/images/${project.image}-960.webp`} srcset={imageSet(project.image)} sizes="(max-width: 700px) 85vw, 70vw" width={project.width} height={project.height} alt={project.alt} loading="lazy" decoding="async" /></div>
              <figcaption><div><h3>{project.title}</h3><p>{project.type}</p></div><a href={project.source} target="_blank" rel="noopener noreferrer" class="project-source" aria-label={`View ${project.type} on Instagram`}>View project <Icon /></a></figcaption>
            </figure>
          ))}
        </div>
        <div class="work-footer section-pad"><span>Every photograph is our actual work.</span><a class="text-link" href="#contact">Have a window in mind? Contact us <Icon /></a></div>
      </section>

      <section class="approach-section section-pad" id="approach" aria-labelledby="approach-heading">
        <div class="approach-image"><img src="/images/layered-room-960.webp" srcset={imageSet('layered-room')} sizes="(max-width: 700px) 88vw, 38vw" width="1013" height="1351" alt="Layered pleated drapes and sheer curtains framing a bright living-room window." loading="lazy" /></div>
        <div class="approach-copy"><h2 id="approach-heading">Your windows.<br />Your way of living.</h2><p>Some rooms call for a soft filter of daylight. Others need a little more privacy. And some deserve a statement.</p><p>Start with your room, your ideas and the feeling you want to come home to. We’ll talk through the possibilities with you.</p><a class="button button-outline" href="#contact">Tell us about your space <Icon /></a></div>
      </section>

      <section class="detail-section" aria-labelledby="detail-heading" data-carousel>
        <div class="section-heading section-pad"><h2 id="detail-heading">It’s all in the details.</h2><div class="carousel-navigation"><span class="slide-count" data-count aria-live="polite">1 / {details.length}</span><button class="circle-button previous" data-prev aria-label="Previous curtain detail" disabled><Icon name="chevron" /></button><button class="circle-button" data-next aria-label="Next curtain detail"><Icon name="chevron" /></button></div></div>
        <div class="detail-track" data-track aria-label="Curtain and blind details" role="region" tabindex="0">
          {details.map(detail => (
            <figure class="detail-slide" data-slide><div class="detail-photo"><img src={`/images/${detail.image}-960.webp`} srcset={imageSet(detail.image)} sizes="(max-width: 700px) 76vw, 38vw" width="960" height="960" alt={`${detail.type}: a closer view from an actual Mac2Din2 installation.`} style={`object-position:${detail.position}`} loading="lazy" /></div><figcaption><h3>{detail.title}</h3><p>{detail.type}</p></figcaption></figure>
          ))}
        </div>
      </section>

      <section class="contact-section section-pad" id="contact" aria-labelledby="contact-heading">
        <div class="contact-intro" data-parallax="22"><h2 id="contact-heading">Let’s talk about<br />your windows.</h2><p>A new room, a fresh look, or an idea you’d love to explore.<br class="desktop-break" /> Start a conversation with Mac2Din2 House of Curtains.</p></div>
        <div class="contact-links">
          <a href="tel:+639178361524" class="contact-primary"><span><small>Give us a call</small><span>0917 836 1524</span></span><Icon name="phone" /></a>
          <a href="tel:+639228169859" class="contact-secondary"><span>Or call 0922 816 9859</span><Icon /></a>
          <a href="https://www.instagram.com/mac2din2houseofcurtain/" target="_blank" rel="noopener noreferrer" class="instagram-link"><Icon name="instagram" /><span>Open Instagram<small>Tap Message on our profile</small></span><Icon /></a>
          <p class="contact-tip">Have a photo of your window? Share it when you message us.</p>
        </div>
      </section>
    </main>

    <footer class="site-footer section-pad"><a class="footer-brand" href="#" data-parallax="10">Mac2Din2 <span>House of Curtains</span></a><p>Curtains. Light. A feeling of home.</p><a href="#main" class="back-top">Back to top <Icon /></a></footer>
    <a class="mobile-contact" href="#contact">Let’s talk about your windows <Icon /></a>
    <script>
      import { initCarousel } from '../scripts/carousel';
      import { initOpening } from '../scripts/opening';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      document.documentElement.classList.add('has-js');
      const opening = document.getElementById('opening-curtain')!;
      const pageParts = [...document.querySelectorAll<HTMLElement>('.site-header, main, .site-footer, .mobile-contact')];
      const finishOpening = initOpening(opening, pageParts, matchMedia('(prefers-reduced-motion: reduce)').matches || Boolean(location.hash && location.hash !== '#'));
      const disposers = [...document.querySelectorAll<HTMLElement>('[data-carousel]')].map(initCarousel);
      const observer = new IntersectionObserver(([entry]) => document.body.classList.toggle('contact-visible', entry.isIntersecting), { threshold: 0.15 });
      observer.observe(document.getElementById('contact')!);
      gsap.registerPlugin(ScrollTrigger);
      const media = gsap.matchMedia();
      media.add('(prefers-reduced-motion: no-preference)', () => {
        gsap.fromTo('.approach-image img', { yPercent: -3 }, { yPercent: -9, ease: 'none', scrollTrigger: { trigger: '.approach-image', start: 'top bottom', end: 'bottom top', scrub: true } });
        gsap.utils.toArray<HTMLElement>('[data-parallax]').forEach(element => {
          const distance = Number(element.dataset.parallax) || 20;
          gsap.fromTo(element, { y: distance }, { y: -distance, ease: 'none', scrollTrigger: { trigger: element.closest('section, footer')!, start: 'top bottom', end: 'bottom top', scrub: 0.6 } });
        });
        gsap.utils.toArray<HTMLElement>('.work-photo img').forEach(element => gsap.fromTo(element, { yPercent: -3 }, { yPercent: 3, ease: 'none', scrollTrigger: { trigger: '#works', start: 'top bottom', end: 'bottom top', scrub: 0.6 } }));
        gsap.utils.toArray<HTMLElement>('.detail-photo img').forEach(element => gsap.fromTo(element, { yPercent: -3 }, { yPercent: 3, ease: 'none', scrollTrigger: { trigger: '.detail-section', start: 'top bottom', end: 'bottom top', scrub: 0.6 } }));
      });
      window.addEventListener('pagehide', event => {
        if (event.persisted) return;
        finishOpening(); disposers.forEach(dispose => dispose()); observer.disconnect(); media.revert();
      });
    </script>
  </body>
</html>
