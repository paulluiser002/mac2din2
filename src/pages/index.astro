---
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/bodoni-moda/400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import Films from '../components/Films.astro';
import SceneLoader from '../components/SceneLoader';
import { gallery, imageSet } from '../data/projects';
const features = gallery('feature');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf7" />
    <title>Mac2Din2 House of Curtains — A different feeling. In every fold.</title>
    <meta name="description" content="Explore curtains, sheers and blinds by Mac2Din2 House of Curtains. Discover our installations and contact us about your windows." />
    <meta property="og:title" content="Mac2Din2 House of Curtains" />
    <meta property="og:description" content="A different feeling. In every fold. Explore our curtain and blind installations." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/favicon.png" />

  </head>
  <body>
    <div class="opening-curtain" id="opening-curtain">
      <canvas class="opening-cloth" aria-hidden="true"></canvas><div class="opening-panel opening-left" aria-hidden="true"></div>
      <div class="opening-panel opening-right" aria-hidden="true"></div>
      <div class="opening-signature" aria-hidden="true"><span>Mac2Din2</span><span>House of Curtains</span></div>
      <button class="opening-skip" type="button">Skip intro <Icon /></button>
    </div>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="#" aria-label="Mac2Din2 House of Curtains home"><img src="/images/logo.webp" width="130" height="100" alt="Mac2Din2 House of Curtains" fetchpriority="high" /></a>
      <nav aria-label="Main navigation">
        <a href="#works">Our work</a>
        <a href="#curtains" class="nav-secondary">Curtains & blinds</a>
        <a href="#approach" class="nav-secondary">Our approach</a>
      </nav>
      <a class="header-contact" href="#contact">Contact us <Icon /></a>
    </header>

    <div class="room-frame" id="room-frame" aria-hidden="true"><div class="window-fallback"><div class="fallback-outlook"></div><div class="fallback-window"></div><div class="fallback-sheer"></div><div class="fallback-drape left"></div><div class="fallback-drape right"></div></div><div id="scene-mount"><SceneLoader client:idle /></div></div>
    <div class="page-light" aria-hidden="true"></div>
    <main id="main">
      <section class="showroom" id="showroom" aria-labelledby="hero-heading">
        <div class="showroom-pin">
          <div class="hero-wash"></div>
          <div class="hero-intro">
            <h1 id="hero-heading">A different feeling.<br />In every fold.</h1>
            <p>Curtains and blinds that bring<br class="desktop-break" /> your space together.</p>
            <div class="hero-actions">
              <a class="button button-dark" href="#contact">Let’s talk about your windows <Icon /></a>
              <a class="text-link" href="#works">Explore our work</a>
            </div>
          </div>
          <div class="hero-story" aria-hidden="true">
            <h2>Let the light<br />change everything.</h2>
            <p>A softer morning. A quieter afternoon.<br />A room that feels more like you.</p>
          </div>
          <div class="hero-bottom">
            <div class="scroll-note"><span class="scroll-line"></span><span>Scroll to let the light in</span></div>
            <p class="scene-caption" id="scene-caption">Illustrative room</p>
          </div>
          <div class="room-controls" id="room-controls" aria-label="Explore the illustrative room" hidden>
            <div class="view-controls" aria-label="Curtain view">
              <button type="button" data-view="sheer" aria-pressed="false">Sheer</button>
              <button type="button" data-view="layered" aria-pressed="false">Layered</button>
              <button type="button" data-view="closed" aria-pressed="false">Closed</button>
              <button type="button" data-view="scroll" class="reset-view" aria-pressed="true" aria-label="Reset curtain view to follow scrolling">Reset view</button>
            </div>
            <div class="fabric-controls"><span>Fabric</span>
              <button class="fabric-swatch fabric-stone" type="button" data-fabric="stone" aria-label="Stone fabric" aria-pressed="true"></button>
              <button class="fabric-swatch fabric-gold" type="button" data-fabric="gold" aria-label="Champagne fabric" aria-pressed="false"></button>
              <button class="fabric-swatch fabric-ivory" type="button" data-fabric="ivory" aria-label="Ivory fabric" aria-pressed="false"></button>
              <span class="fabric-name" id="fabric-name">Stone</span>
            </div>
          </div>
        </div>
      </section>

      <section class="introduction depth-chapter section-pad" id="curtains" aria-labelledby="intro-heading">
        <div class="chapter-copy" data-depth="65"><h2 id="intro-heading">A little privacy.<br />A lot of possibility.</h2><p>The way light falls. The softness of a room. The final detail that makes a space feel complete.</p><p>Explore our actual curtain and blind installations, from a single window to a whole room wrapped in light.</p><a class="text-link" href="#works">Step inside our work <Icon /></a></div>
        <div class="chapter-note" data-depth="-45"><span class="gold-rule"></span><p>Sheers that soften.<br />Drapes that frame.<br />Rooms that feel like home.</p></div>
      </section>

      <Gallery group="living" id="works" title="A softer way to live." copy="Distinct spaces, each with its own way of welcoming the light." />

      <section class="approach-chapter depth-chapter section-pad" id="approach" aria-labelledby="approach-heading">
        <div class="feature-copy" data-depth="50"><h2 id="approach-heading">Your windows.<br />Your way of living.</h2><p>Some rooms call for a soft filter of daylight. Others need a little more privacy. And some deserve a statement.</p><p>Start with your room, your ideas and the feeling you want to come home to. We’ll talk through the possibilities with you.</p><a class="button button-dark" href="#contact">Tell us about your space <Icon /></a></div>

      </section>

      <section class="depth-chapter golden-chapter section-pad" aria-labelledby="golden-heading">
        <div class="chapter-copy" data-depth="70"><h2 id="golden-heading">From daylight<br />to golden hour.</h2><p>A change of light brings a different feeling. Find the curtains that make both feel like home.</p><a class="text-link" href="#films">See the rooms in motion <Icon /></a></div>
        <figure class="golden-photo" data-depth="-65"><img src={`/media/${features[0].id}-1280.webp`} srcset={imageSet(features[0].id)} sizes="(max-width: 700px) 90vw, 53vw" width="1600" height="1067" alt={features[0].alt} loading="lazy" /></figure>
      </section>

      <Films />
      <Gallery group="collection" id="details" title="Find your finishing touch." copy="Layered drapes, classic arrangements and blinds that let you choose the light." />

      <section class="contact-section section-pad" id="contact" aria-labelledby="contact-heading">
        <div class="contact-intro" data-depth="45"><h2 id="contact-heading">Let’s talk about<br />your windows.</h2><p>A new room, a fresh look, or an idea you’d love to explore.<br class="desktop-break" /> Start a conversation with Mac2Din2 House of Curtains.</p></div>
        <div class="contact-links">
          <a href="tel:+639178361524" class="contact-primary"><span><small>Give us a call</small><span>0917 836 1524</span></span><Icon name="phone" /></a>
          <a href="tel:+639228169859" class="contact-secondary"><span>Or call 0922 816 9859</span><Icon /></a>
          <a href="https://www.instagram.com/mac2din2houseofcurtain/" target="_blank" rel="noopener noreferrer" class="instagram-link"><Icon name="instagram" /><span>Open Instagram<small>Tap Message on our profile</small></span><Icon /></a>
          <p class="contact-tip">Have a photo of your window? Share it when you message us.</p>
        </div>
      </section>
    </main>

    <footer class="site-footer section-pad"><a class="footer-brand" href="#" data-depth="18">Mac2Din2 <span>House of Curtains</span></a><p>Curtains. Light. A feeling of home.</p><a href="#main" class="back-top">Back to top <Icon /></a></footer>
    <a class="mobile-contact" href="#contact">Let’s talk about your windows <Icon /></a>
    <script>
      import { initCarousel } from '../scripts/carousel';
      import { initOpening } from '../scripts/opening';
      import { initFilm } from '../scripts/films';
      import { allowsMotion } from '../scripts/motion';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      document.documentElement.classList.add('has-js');
      const opening = document.getElementById('opening-curtain')!;
      const pageParts = [...document.querySelectorAll<HTMLElement>('.site-header, main, .site-footer, .mobile-contact')];
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
      const finishOpening = initOpening(opening, pageParts, !allowsMotion(reducedMotion.matches, saveData) || Boolean(location.hash && location.hash !== '#'));
      const disposers = [...document.querySelectorAll<HTMLElement>('[data-carousel]')].map(initCarousel);
      const filmControllers = [...document.querySelectorAll<HTMLElement>('[data-film]')].map(film => initFilm(film, allowsMotion(reducedMotion.matches, saveData)));
      const motionChange = () => { if (reducedMotion.matches) finishOpening(); filmControllers.forEach(controller => controller.setAutoplay(allowsMotion(reducedMotion.matches, saveData))); };
      reducedMotion.addEventListener('change', motionChange);
      const observer = new IntersectionObserver(entries => entries.forEach(entry => document.body.classList.toggle(entry.target.id === 'showroom' ? 'hero-visible' : 'contact-visible', entry.isIntersecting)), { threshold: 0.05 });
      observer.observe(document.getElementById('contact')!);
      observer.observe(document.getElementById('showroom')!);
      gsap.registerPlugin(ScrollTrigger);
      const media = gsap.matchMedia();
      media.add('(prefers-reduced-motion: no-preference)', () => {
        if (saveData) return;
        gsap.utils.toArray<HTMLElement>('[data-depth]').forEach(element => {
          const distance = Number(element.dataset.depth) || 30;
          gsap.fromTo(element, { y: distance }, { y: -distance, ease: 'none', scrollTrigger: { trigger: element.closest('section, footer')!, start: 'top bottom', end: 'bottom top', scrub: 0.65 } });
        });
      });
      window.addEventListener('pagehide', event => {
        if (event.persisted) return;
        finishOpening(); disposers.forEach(dispose => dispose()); filmControllers.forEach(dispose => dispose()); observer.disconnect(); media.revert();
      });
    </script>
  </body>
</html>
